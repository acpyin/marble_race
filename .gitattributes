# 默认按内容自动识别，文本统一以 LF 入库
* text=auto eol=lf

# Windows 脚本必须保持 CRLF，否则可能无法执行
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
