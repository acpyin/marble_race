# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ---------- 构建产物 ----------
dist/
dist-nosound/
build/
.vite/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ---------- 运行时状态 / 本地工具 ----------
# 预览进程记录、日志、无头浏览器截图与缓存
.run/
# 智能体工作记录（本地记忆，非项目源码）
.workbuddy/
# 检查脚本产出的报告与本地 npm 缓存
work/

# ---------- 部署密钥（严禁入库） ----------
.deploy/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ---------- 环境变量 ----------
.env
.env.*
!.env.example

# ---------- 音乐素材 ----------
# 13 首 ogg 共约 75MB，仅本地保留；克隆后放入同目录即可被 import.meta.glob 自动发现
src/static/music/*
!src/static/music/.gitkeep

# ---------- 杂项 ----------
coverage/
*.lcov
.nyc_output/
*.tgz
.cache/
.eslintcache
.stylelintcache
.node_repl_history
